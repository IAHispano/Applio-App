{
  "inference": [
    {
      "name": "cleanupMode",
      "type": "enum",
      "default": "off",
      "values": ["off", "light", "speech"]
    },
    {
      "name": "cleanupStrength",
      "type": "number",
      "default": 12,
      "min": 1,
      "max": 30
    },
    {
      "name": "pthPath",
      "type": "string",
      "min": 1
    },
    {
      "name": "indexPath",
      "type": "string",
      "default": ""
    },
    {
      "name": "pitch",
      "type": "number",
      "default": 0,
      "integer": true,
      "min": -24,
      "max": 24
    },
    {
      "name": "indexRate",
      "type": "number",
      "default": 0.75,
      "min": 0,
      "max": 1
    },
    {
      "name": "volumeEnvelope",
      "type": "number",
      "default": 1,
      "min": 0,
      "max": 1
    },
    {
      "name": "protect",
      "type": "number",
      "default": 0.5,
      "min": 0,
      "max": 0.5
    },
    {
      "name": "f0Method",
      "type": "enum",
      "default": "rmvpe",
      "values": [
        "crepe",
        "rmvpe",
        "fcpe",
        "swift"
      ]
    },
    {
      "name": "inferenceEngine",
      "type": "enum",
      "default": "torch",
      "values": [
        "torch",
        "onnx"
      ]
    },
    {
      "name": "onnxPrecision",
      "type": "enum",
      "default": "auto",
      "values": [
        "auto",
        "float32",
        "float16"
      ]
    },
    {
      "name": "f0Autotune",
      "type": "boolean",
      "default": false
    },
    {
      "name": "f0AutotuneStrength",
      "type": "number",
      "default": 1,
      "min": 0,
      "max": 1
    },
    {
      "name": "proposedPitch",
      "type": "boolean",
      "default": false
    },
    {
      "name": "proposedPitchThreshold",
      "type": "number",
      "default": 155,
      "min": 50,
      "max": 1200
    },
    {
      "name": "exportFormat",
      "type": "enum",
      "default": "WAV",
      "values": [
        "WAV",
        "MP3",
        "FLAC",
        "OGG",
        "M4A"
      ]
    },
    {
      "name": "embedderModel",
      "type": "enum",
      "default": "contentvec",
      "values": [
        "contentvec",
        "spin",
        "spin-v2",
        "chinese-hubert-base",
        "japanese-hubert-base",
        "korean-hubert-base",
        "custom"
      ]
    },
    {
      "name": "embedderModelCustom",
      "type": "string",
      "default": ""
    },
    {
      "name": "sid",
      "type": "number",
      "default": 0,
      "integer": true,
      "min": 0
