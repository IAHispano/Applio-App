{
	"name": "applio-app-monorepo",
	"private": true,
	"scripts": {
		"build": "node scripts/buildRelease.js",
		"build:server": "node scripts/buildBackend.js",
		"build:installer": "cd apps/installer && pnpm tauri build && copy src-tauri\\target\\release\\installer-applio-app.exe ..\\..\\build\\install-applio-app.exe",
		"server": "cd apps/server && env\\Scripts\\activate && call ./env/scripts/activate.bat && python server.py",
		"dev": "turbo dev",
		"desktop": "pnpm --filter desktop --",
		"tauri": "dotenv -- pnpm desktop tauri",
		"installer": "dotenv -- pnpm --filter installer --",
		"format": "pnpm biome format --write ."
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"turbo": "^2.2.3",
		"typescript": "^5.6.3"
	},
	"packageManager": "pnpm@9.12.2",
	"engines": {
		"node": ">=18"
	},
	"dependencies": {
		"dotenv": "^16.4.5",
		"dotenv-cli": "github:motdotla/dotenv-cli"
	}
}
