{
  "name": "applio",
  "version": "0.2.7",
  "private": true,
  "description": "Lightweight interface for fast interaction with advanced AI-based voice technology.",
  "packageManager": "pnpm@11.15.0",
  "bin": {
    "applio": "./bin/applio.js"
  },
  "scripts": {
    "cli": "node bin/applio.js",
    "applio": "node bin/applio.js",
    "clean": "node bin/applio.js clean",
    "dev": "pnpm backend:check:dev && concurrently \"pnpm --filter @applio/api dev\" \"pnpm --filter @applio/web dev\"",
    "dev:api": "pnpm backend:check:dev && pnpm --filter @applio/api dev",
    "dev:web": "pnpm --filter @applio/web dev",
    "build": "pnpm backend:check && pnpm --filter @applio/api build && pnpm --filter @applio/web build",
    "start": "node backend/api/dist/index.js & node frontend/web/.next/standalone/server.js",
    "typecheck": "pnpm -r typecheck",
    "format": "biome check --write frontend backend/api",
    "format:check": "biome check frontend backend/api",
    "desktop:dev": "concurrently -k -s first \"pnpm dev:api\" \"pnpm dev:web\" \"pnpm --filter @applio/desktop dev\"",
    "desktop:shell": "pnpm backend:check:dev && pnpm --filter @applio/desktop dev",
    "build:all": "pnpm backend:check && pnpm --filter @applio/api build && pnpm --filter @applio/web build && pnpm --filter @applio/desktop build",
    "build:win": "pnpm build:all && pnpm --filter @applio/desktop dist:win",
    "build:mac": "pnpm build:all && pnpm --filter @applio/desktop dist:mac",
    "build:linux": "pnpm build:all && pnpm --filter @applio/desktop dist:linux",
    "dist:win": "pnpm build:all && pnpm --filter @applio/desktop dist:win",
    "dist:mac": "pnpm build:all && pnpm --filter @applio/desktop dist:mac",
    "dist:linux": "pnpm build:all && pnpm --filter @applio/desktop dist:linux",
    "backend:init": "git submodule update --init --recursive",
    "backend:check": "node scripts/check-backend.mjs",
    "backend:check:dev": "node scripts/check-backend.mjs --dev",
    "reliability:check": "node scripts/check-reliability.mjs && node scripts/check-batch.mjs && node scripts/check-voice-focus.mjs && node scripts/check-realtime-settings.mjs && node scripts/check-tray.mjs && node scripts/check-setting-help.mjs && node scripts/check-i18n.mjs --check",
    "i18n:check": "node scripts/check-i18n.mjs --check",
    "runtime:check": "node scripts/check-runtime.mjs",
    "release:check": "pnpm reliability:check && node scripts/check-runtime.mjs --packaged"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "concurrently": "^9.1.2",
    "typescript": "^5.7.2"
  }
}
