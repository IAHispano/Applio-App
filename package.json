{
  "name": "applio",
  "version": "1.0.7",
  "private": true,
  "description": "Lightweight interface for fast interaction with advanced AI-based voice technology.",
  "packageManager": "pnpm@11.15.0",
  "bin": {
    "applio": "./bin/applio.js"
  },
  "scripts": {
    "cli": "node bin/applio.js",
    "applio": "node bin/applio.js",
    "clean": "node bin/applio.js clean",
    "dev": "concurrently -k \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "pnpm backend:check:dev && node scripts/run-services.mjs --no-web",
    "dev:web": "pnpm --filter @applio/web dev",
    "build": "pnpm build:web-services && node scripts/cargo.mjs build --release -p applio-api",
    "start": "node scripts/run-services.mjs --production",
    "typecheck": "pnpm -r typecheck && node scripts/cargo.mjs check --workspace",
    "format": "biome check --write frontend && node scripts/cargo.mjs fmt --all",
    "format:check": "biome check frontend && node scripts/cargo.mjs fmt --all -- --check",
    "desktop:dev": "pnpm --filter @applio/desktop dev",
    "desktop:shell": "pnpm --filter @applio/desktop dev",
    "build:all": "pnpm --filter @applio/desktop build",
    "build:win": "pnpm --filter @applio/desktop dist:win",
    "build:mac": "pnpm --filter @applio/desktop dist:mac",
    "build:linux": "pnpm --filter @applio/desktop dist:linux",
    "dist:win": "pnpm build:win",
    "dist:mac": "pnpm build:mac",
    "dist:linux": "pnpm build:linux",
    "backend:init": "git submodule update --init --recursive",
    "backend:check": "node scripts/check-backend.mjs",
    "backend:check:dev": "node scripts/check-backend.mjs --dev",
    "build:web-services": "pnpm backend:check && pnpm --filter @applio/web build",
    "i18n:extract": "node scripts/i18n/extract.mjs",
    "i18n:sync": "node scripts/i18n/sync.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "concurrently": "^9.1.2",
    "typescript": "^5.7.2"
  }
}
