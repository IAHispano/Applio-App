{
  "name": "@applio/desktop",
  "version": "0.1.1",
  "private": true,
  "description": "Lightweight interface for fast interaction with advanced AI-based voice technology.",
  "author": "AI Hispano",
  "homepage": "https://github.com/IAHispano/Applio-app",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "pnpm build && electron .",
    "dist:win": "pnpm build && electron-builder --win --publish never",
    "dist:mac": "pnpm build && electron-builder --mac --publish never",
    "dist:linux": "pnpm build && electron-builder --linux --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "^25.1.8",
    "rcedit": "^5.0.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
