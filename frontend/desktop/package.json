{
  "name": "@applio/desktop",
  "version": "1.0.5",
  "private": true,
  "description": "Lightweight interface for fast interaction with advanced AI-based voice technology.",
  "author": "AI Hispano",
  "homepage": "https://github.com/IAHispano/Applio-app",
  "scripts": {
    "prepare:dev": "pnpm -w backend:check:dev && pnpm --filter @applio/web build",
    "prepare:release": "pnpm -w build:web-services && node scripts/stage-resources.mjs",
    "build": "node scripts/tauri-build.mjs --no-bundle",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:rust": "node ../../scripts/cargo.mjs check -p applio-desktop",
    "dev": "node scripts/tauri-dev.mjs",
    "dist:win": "node scripts/tauri-build.mjs --bundles nsis",
    "dist:mac": "node scripts/tauri-build.mjs --bundles dmg,app",
    "dist:linux": "node scripts/tauri-build.mjs --bundles appimage,deb"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.18.1",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "ws": "^8.21.3"
  }
}
